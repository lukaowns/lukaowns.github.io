$DebugPreference = "SilentlyContinue"

Write-Host "Select Mode:" -ForegroundColor Cyan
Write-Host "1. Normal Mode"
Write-Host "2. Debug Mode"
Write-Host "3. Remove Stretch (All Folders + Debug)"
$mode = Read-Host "Choice"

$configPath = "$env:LOCALAPPDATA\VALORANT\Saved\Config"
$riotLocalFile = "$configPath\WindowsClient\RiotLocalMachine.ini"
$docPath = Join-Path ([Environment]::GetFolderPath("MyDocuments")) "Valorant Stretch"
$discord = "https://discord.gg/7bee9YVnUn"

if ($mode -eq "3") {
    Write-Host "[DEBUG] Starting Removal Process..." -ForegroundColor Yellow
    if (-not (Test-Path $riotLocalFile)) { Write-Error "RiotLocalMachine.ini not found."; Read-Host; return }
    
    $guidLine = Select-String -Path $riotLocalFile -Pattern "LastKnownUser=(.*)"
    $guid = $guidLine.Matches.Groups[1].Value.Trim()
    
    $userFolders = Get-ChildItem -Path $configPath -Directory | Where-Object { $_.Name -like "$guid*" }
    $count = 0

    foreach ($folder in $userFolders) {
        $iniFile = "$($folder.FullName)\WindowsClient\GameUserSettings.ini"
        if (Test-Path $iniFile) {
            Write-Host "[DEBUG] Cleaning: $($folder.Name)" -ForegroundColor Gray
            Set-ItemProperty $iniFile -Name IsReadOnly -Value $false
            
            $lines = Get-Content $iniFile
            $filteredLines = $lines | Where-Object { $_.Trim() -ne "FullscreenMode=2" }
            $filteredLines | Set-Content $iniFile -Encoding UTF8
            $count++
        }
    }
    Write-Host "`nStretch removed and Read-Only turned off for $count folder(s)." -ForegroundColor Green
    Write-Host "Support: " -NoNewline; Write-Host $discord -ForegroundColor Magenta
    Read-Host "`nPress Enter to exit."; return
}

if ($mode -eq "2") {
    $DebugPreference = "Continue"
    Write-Host "[DEBUG] Debug Mode Enabled.`n" -ForegroundColor Yellow
}

if (Get-Process -Name "VALORANT*" -ErrorAction SilentlyContinue) {
    Write-Host "`n[ERROR] VALORANT is currently running!" -ForegroundColor Red
    Write-Host "Please close the game and rerun the tool." -ForegroundColor White
    Read-Host "`nPress Enter to exit"
    return
}

$resX = Read-Host "Enter Width (e.g., 1280)"
$resY = Read-Host "Enter Height (e.g., 960)"

if (-not (Test-Path $riotLocalFile)) { Write-Error "RiotLocalMachine.ini not found."; Read-Host; return }
$guidLine = Select-String -Path $riotLocalFile -Pattern "LastKnownUser=(.*)"
$guid = $guidLine.Matches.Groups[1].Value.Trim()

if (-not (Test-Path $docPath)) { New-Item -Path $docPath -ItemType Directory | Out-Null }
$helperFile = Join-Path $docPath "Config_Path.txt"
$pathLog = "Folders updated:`r`n"
$userFolders = Get-ChildItem -Path $configPath -Directory | Where-Object { $_.Name -like "$guid*" }
$appliedCount = 0

foreach ($folder in $userFolders) {
    $targetFolder = "$($folder.FullName)\WindowsClient"
    $gameSettingsPath = "$targetFolder\GameUserSettings.ini"

    if (-not (Test-Path $gameSettingsPath)) { continue }

    $appliedCount++
    if ($mode -eq "2") { Write-Host "[DEBUG] Updating: $($folder.Name)" -ForegroundColor Gray }
    $pathLog += "$targetFolder`r`n"

    if ((Get-Item $gameSettingsPath).IsReadOnly) { Set-ItemProperty $gameSettingsPath -Name IsReadOnly -Value $false }
    Copy-Item $gameSettingsPath "$gameSettingsPath.bak" -Force

    $settings = Get-Content $gameSettingsPath
    $newSettings = @()
    $insideShooter = $false
    $fullscreenInserted = $false

    foreach ($line in $settings) {
        $trimmed = $line.Trim()
        if ($trimmed -eq "[/Script/ShooterGame.ShooterGameUserSettings]") {
            $insideShooter = $true
            $newSettings += $line
            continue
        }
        if ($trimmed -match "^\[.*\]") {
            if ($insideShooter -and -not $fullscreenInserted) {
                $newSettings += "FullscreenMode=2"
                $newSettings += ""
                $fullscreenInserted = $true
            }
            $insideShooter = $false
        }
        if ($insideShooter) {
            if ([string]::IsNullOrWhiteSpace($trimmed)) { continue }
            switch -Wildcard ($trimmed) {
                "bShouldLetterbox=*" { $line = "bShouldLetterbox=False" }
                "bLastConfirmedShouldLetterbox=*" { $line = "bLastConfirmedShouldLetterbox=False" }
                "ResolutionSizeX=*" { $line = "ResolutionSizeX=$resX" }
                "ResolutionSizeY=*" { $line = "ResolutionSizeY=$resY" }
                "LastUserConfirmedResolutionSizeX=*" { $line = "LastUserConfirmedResolutionSizeX=$resX" }
                "LastUserConfirmedResolutionSizeY=*" { $line = "LastUserConfirmedResolutionSizeY=$resY" }
                "LastConfirmedFullscreenMode=*" { $line = "LastConfirmedFullscreenMode=0" }
                "PreferredFullscreenMode=*" { $line = "PreferredFullscreenMode=0" }
                "FullscreenMode=*" { $line = "FullscreenMode=2"; $fullscreenInserted = $true }
            }
        }
        $newSettings += $line
    }

    if ($insideShooter -and -not $fullscreenInserted) { $newSettings += "FullscreenMode=2" }
    $newSettings | Set-Content $gameSettingsPath -Encoding UTF8
    Set-ItemProperty $gameSettingsPath -Name IsReadOnly -Value $true
}

$pathLog | Set-Content -Path $helperFile

Write-Host "`nApplied successfully to $appliedCount account folder(s) ($resX x $resY)" -ForegroundColor Green
Write-Host "Configs set to Read-Only." -ForegroundColor Cyan
Write-Host "Folder paths saved to: $docPath" -ForegroundColor Yellow
Write-Host "`nSupport: " -NoNewline; Write-Host $discord -ForegroundColor Magenta
Write-Host "`nPress Enter to exit."
Read-Host
