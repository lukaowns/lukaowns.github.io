$DebugPreference = "SilentlyContinue"



Write-Host "Select Mode:" -ForegroundColor Pink

Write-Host "1. Normal Mode"

Write-Host "2. Debug Mode"

Write-Host "3. Remove Stretch and Fix Settings"

$mode = Read-Host "Choice"



$configPath = "$env:LOCALAPPDATA\VALORANT\Saved\Config"

$riotLocalFile = "$configPath\WindowsClient\RiotLocalMachine.ini"



if ($mode -eq "3") {

    if (-not (Test-Path $riotLocalFile)) {

        Write-Error "RiotLocalMachine.ini not found."

        Read-Host; return

    }

    $guidLine = Select-String -Path $riotLocalFile -Pattern "LastKnownUser=(.*)"

    $guid = $guidLine.Matches.Groups[1].Value.Trim()

    $userFolder = Get-ChildItem -Path $configPath -Directory | Where-Object { $_.Name -like "$guid*" } | Sort-Object LastWriteTime -Descending | Select-Object -First 1

    $iniFile = "$($userFolder.FullName)\WindowsClient\GameUserSettings.ini"



    if (Test-Path $iniFile) {

        Set-ItemProperty $iniFile -Name IsReadOnly -Value $false

        $lines = Get-Content $iniFile

        $filteredLines = $lines | Where-Object { $_ -ne "FullscreenMode=2" }

        $filteredLines | Set-Content $iniFile -Encoding UTF8

        Write-Host "Stretch removed and Read-Only turned off." -ForegroundColor Green

    } else {

        Write-Error "GameUserSettings.ini not found."

    }

    Read-Host "Press Enter to exit."; return

}



if ($mode -eq "2") {

    $DebugPreference = "Continue"

    Write-Host "[DEBUG] Debug Mode Enabled.`n" -ForegroundColor Yellow

}



if (Get-Process -Name "VALORANT*" -ErrorAction SilentlyContinue) {

    Write-Error "VALORANT is running. Close the game and try again."

    Read-Host "Press Enter to exit"; return

}



$resX = Read-Host "Enter Width (e.g., 1280)"

$resY = Read-Host "Enter Height (e.g., 960)"



